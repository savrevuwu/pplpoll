# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://pplpoll:pplpoll@localhost:5432/pplpoll
TEST_DATABASE_URL=postgres://pplpoll:pplpoll@localhost:5432/pplpoll_test
REDIS_URL=redis://localhost:6379
API_PORT=3000
LOG_LEVEL=info
# Generate each with: openssl rand -base64 32   (keep real values in the secret store only)
APP_ENCRYPTION_KEY=
APP_HMAC_KEY=
